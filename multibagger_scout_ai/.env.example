# Copy to .env. No paid keys are required for any core feature.
DATABASE_URL=sqlite:///scout.db
EXPORT_DIR=exports
HISTORY_PERIOD=10y
DCF_DISCOUNT_RATE=0.12
DCF_TERMINAL_GROWTH=0.05
NEWS_FEED_TEMPLATE=https://news.google.com/rss/search?q={query}&hl=en-IN&gl=IN&ceid=IN:en
NEWS_MAX_ITEMS=30
HTTP_TIMEOUT=15

# --- Optional ---
# Hosted/Postgres: DATABASE_URL=postgresql://user:password@host/dbname
# APP_PASSWORD=choose-a-long-password      (turns on a password screen; strongly advised for any public website)
# API_KEY=...                              (backend only: requires header X-API-Key)
# RATE_LIMIT_PER_MIN=30
# DAILY_CHECK_TIME=18:30                   (IST, Mon-Fri; also editable on Floor 00)
# NSE_EQUITY_LIST_URL=https://nsearchives.nseindia.com/content/equities/EQUITY_L.csv

# --- Automation agent notifications (all optional; set any one) ---
# NTFY_TOPIC=a-long-unguessable-topic-name       (free; install the ntfy app and subscribe to the same topic; anyone who knows the topic can read it)
# TELEGRAM_BOT_TOKEN=...   TELEGRAM_CHAT_ID=...   (free; create a bot with @BotFather)
# SMTP_HOST=smtp.example.com SMTP_PORT=587 SMTP_USER=... SMTP_PASSWORD=... SMTP_FROM=... SMTP_TO=you@example.com
# WEBHOOK_URL=https://...                          (https only; posts JSON {"text": "...", "content": "..."})
# PROBE_SYMBOL=RELIANCE  PROBE_RETRIES=2  PROBE_DELAY_S=120  CYCLE_RETRIES=1  STALE_DAYS=4  BUSY_HOURS=3
